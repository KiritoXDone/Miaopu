<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_row_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/widget_text"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""/>
            <TextView
                android:id="@+id/widget_row_sport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="@color/widget_secondary"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <FrameLayout
                android:layout_width="22dp"
                android:layout_height="22dp">
                <ImageView
                    android:id="@+id/widget_row_logo_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:id="@+id/widget_row_fallback_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textSize="11sp"
                    android:textColor="@color/widget_accent"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text=""
                    android:gravity="center"
                    android:background="@drawable/widget_placeholder"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <TextView
                android:id="@+id/widget_row_team_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/widget_text"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""
                android:layout_weight="1"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/widget_row_score"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/widget_text"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:gravity="center"
            android:textStyle="bold"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <FrameLayout
                android:layout_width="22dp"
                android:layout_height="22dp">
                <ImageView
                    android:id="@+id/widget_row_logo_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:id="@+id/widget_row_fallback_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textSize="11sp"
                    android:textColor="@color/widget_accent"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text=""
                    android:gravity="center"
                    android:background="@drawable/widget_placeholder"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
            <TextView
                android:id="@+id/widget_row_team_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/widget_text"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=""
                android:layout_weight="1"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_divider"
        android:importantForAccessibility="no"/>
</LinearLayout>
